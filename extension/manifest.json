{
  "manifest_version": 3,
  "name": "Farmland Boundary Detector",
  "description": "Detect farmland boundaries on Google Maps using a SegFormer FastAPI backend.",
  "version": "2.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://maps.google.com/*",
    "https://earth.google.com/*",
    "https://www.google.com/earth/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Detect Farmland Boundaries"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*",
        "https://earth.google.com/*",
        "https://www.google.com/earth/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}